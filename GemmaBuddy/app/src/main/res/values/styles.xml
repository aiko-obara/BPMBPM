<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Base parent styles (required for dot-hierarchy) ── -->
    <style name="NR" />
    <style name="NR.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="NR.Text" />
    <style name="NR.Text.Headline" />
    <style name="NR.Text.Body" />
    <style name="NR.Text.Label" />

    <!-- ── Typography ─────────────────────────────── -->
    <style name="NR.Text.Headline.XL">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nr_on_surface</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="NR.Text.Headline.LG">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nr_on_surface</item>
    </style>

    <style name="NR.Text.Headline.MD">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nr_on_surface</item>
    </style>

    <style name="NR.Text.Headline.SM">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nr_on_surface</item>
    </style>

    <style name="NR.Text.Label.MD">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/nr_on_surface</item>
    </style>

    <style name="NR.Text.Label.Primary">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/nr_primary</item>
    </style>

    <style name="NR.Text.Body.MD">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nr_on_surface</item>
    </style>

    <style name="NR.Text.Body.SM">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nr_on_surface_variant</item>
    </style>

    <!-- ── Buttons ────────────────────────────────── -->
    <style name="NR.Button.Primary">
        <item name="android:background">@drawable/bg_brutalist_button_primary</item>
        <item name="android:textColor">@color/nr_on_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>

    <style name="NR.Button.Secondary">
        <item name="android:background">@drawable/bg_brutalist_button_secondary</item>
        <item name="android:textColor">@color/nr_on_surface</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>

    <style name="NR.Button.Danger">
        <item name="android:background">@drawable/bg_brutalist_button_danger</item>
        <item name="android:textColor">@color/nr_error</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
    </style>

</resources>
