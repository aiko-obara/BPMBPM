<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy theme (kept for non-migrated refs) -->
    <style name="Theme.GemmaBuddy" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>

    <!-- Light theme (Home, Buddies, Settings) -->
    <style name="Theme.GemmaBuddy.Neo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nr_primary</item>
        <item name="colorOnPrimary">@color/nr_on_primary</item>
        <item name="android:windowBackground">@color/nr_surface</item>
        <item name="android:statusBarColor">@color/nr_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dark theme (Splash, History) -->
    <style name="Theme.GemmaBuddy.Neo.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/nr_cyan</item>
        <item name="colorOnPrimary">@color/nr_on_cyan</item>
        <item name="android:windowBackground">@color/nr_dark_surface</item>
        <item name="android:statusBarColor">@color/nr_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
