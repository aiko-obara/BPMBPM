<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/nr_dark_surface"
    android:padding="32dp">

    <!-- Logo card -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_dark_card"
        android:gravity="center"
        android:layout_marginBottom="32dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="72sp" />
    </LinearLayout>

    <!-- GEMMABUDDY italic title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GEMMABUDDY"
        android:fontFamily="@font/space_grotesk"
        android:textSize="38sp"
        android:textStyle="bold|italic"
        android:textColor="@color/nr_dark_on_surface"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INITIALIZING COGNITIVE MATRIX..."
        android:fontFamily="@font/inter"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textColor="@color/nr_dark_on_surface_variant"
        android:layout_marginBottom="80dp" />

    <!-- Bottom: SYS.BOOT + progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SYS.BOOT"
                android:fontFamily="@font/inter"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="@color/nr_dark_on_surface_variant" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK"
                android:fontFamily="@font/inter"
                android:textSize="11sp"
                android:textColor="@color/nr_cyber_green" />
        </LinearLayout>

        <!-- Segmented progress bar (cyan) -->
        <LinearLayout
            android:id="@+id/tv_loading_dots"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:orientation="horizontal"
            android:weightSum="10">
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_cyan"
                android:layout_marginRight="2dp" android:id="@+id/seg1"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_cyan"
                android:layout_marginRight="2dp" android:id="@+id/seg2"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_cyan"
                android:layout_marginRight="2dp" android:id="@+id/seg3"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_cyan"
                android:layout_marginRight="2dp" android:id="@+id/seg4"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"
                android:layout_marginRight="2dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"
                android:layout_marginRight="2dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"
                android:layout_marginRight="2dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"
                android:layout_marginRight="2dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"
                android:layout_marginRight="2dp"/>
            <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/nr_dark_container_high"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
