<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/nr_dark_surface"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:elevation="8dp">

    <EditText
        android:id="@+id/et_dialog_input"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/bg_rounded_input"
        android:textColor="@color/nr_on_surface"
        android:textColorHint="@color/nr_on_surface_variant"
        android:hint="返事する..."
        android:textSize="14sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btn_dialog_send"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:text="送信"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/nr_on_primary"
        android:background="@drawable/bg_primary_button"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/btn_dialog_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="×"
        android:textSize="16sp"
        android:textColor="@color/nr_on_surface_variant"
        android:background="@drawable/bg_secondary_button" />

</LinearLayout>
