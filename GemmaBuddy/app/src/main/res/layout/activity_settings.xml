<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nr_surface"
    android:fitsSystemWindows="true">

    <include layout="@layout/include_top_app_bar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Page heading -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:fontFamily="@font/space_grotesk" android:textSize="28sp"
                android:textStyle="bold" android:textColor="@color/nr_on_surface"
                android:layout_marginBottom="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_desc"
                android:fontFamily="@font/inter" android:textSize="14sp"
                android:textColor="@color/nr_on_surface_variant"
                android:layout_marginBottom="24dp" />

            <!-- SPEECH CONFIGURATION section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_glass_card"
                android:padding="20dp" android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_primary" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_speech_config"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_voice_velocity"
                    android:fontFamily="@font/inter" android:textSize="10sp"
                    android:textStyle="bold" android:letterSpacing="0.08"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="8dp" />

                <!-- Speed segmented control -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_input"
                    android:layout_marginBottom="20dp">
                    <Button android:id="@+id/btn_speed_slow"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/settings_speed_slow"
                        android:background="@drawable/bg_dark_segment_unselected"
                        android:textColor="@color/nr_on_surface_variant"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05" />
                    <Button android:id="@+id/btn_speed_normal"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/settings_speed_norm"
                        android:background="@drawable/bg_dark_segment_selected"
                        android:textColor="@color/nr_primary"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05" />
                    <Button android:id="@+id/btn_speed_fast"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/settings_speed_fast"
                        android:background="@drawable/bg_dark_segment_unselected"
                        android:textColor="@color/nr_on_surface_variant"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.05" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_autotalk"
                    android:fontFamily="@font/inter" android:textSize="10sp"
                    android:textStyle="bold" android:letterSpacing="0.08"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="8dp" />

                <!-- Interval stepper -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/btn_interval_minus"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:text="−" android:textSize="20sp"
                        android:background="@drawable/bg_secondary_button"
                        android:textColor="@color/nr_primary" />
                    <TextView android:id="@+id/tv_interval_value"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1" android:text="5m"
                        android:fontFamily="@font/space_grotesk" android:textSize="20sp"
                        android:textStyle="bold" android:textColor="@color/nr_on_surface"
                        android:gravity="center"
                        android:background="@drawable/bg_rounded_input" />
                    <Button android:id="@+id/btn_interval_plus"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:text="+" android:textSize="20sp"
                        android:background="@drawable/bg_secondary_button"
                        android:textColor="@color/nr_primary" />
                </LinearLayout>
            </LinearLayout>



            <!-- NOTIFICATION ACCESS section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_glass_card"
                android:padding="20dp" android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_cyber_green" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_notif_access"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="12dp" />

                <TextView android:id="@+id/tv_notification_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_notif_status_off"
                    android:fontFamily="@font/inter" android:textSize="13sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="12dp" />

                <Button android:id="@+id/btn_notification_access"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="@string/settings_notif_button"
                    android:background="@drawable/bg_secondary_button"
                    android:textColor="@color/nr_primary"
                    android:fontFamily="@font/inter" android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SCREEN VISION section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_glass_card"
                android:padding="20dp" android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_cyber_green" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_vision"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="12dp" />

                <TextView android:id="@+id/tv_vision_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_vision_status_off"
                    android:fontFamily="@font/inter" android:textSize="13sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="4dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_vision_desc"
                    android:fontFamily="@font/inter" android:textSize="11sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="12dp" />

                <Button android:id="@+id/btn_vision_toggle"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="@string/settings_vision_enable"
                    android:background="@drawable/bg_secondary_button"
                    android:textColor="@color/nr_primary"
                    android:fontFamily="@font/inter" android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- LANGUAGE section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_glass_card"
                android:padding="20dp" android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_accent_yellow" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_ui_language"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="12dp" />

                <TextView android:id="@+id/tv_ui_language_current"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/lang_system"
                    android:fontFamily="@font/inter" android:textSize="13sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="12dp" />

                <Button android:id="@+id/btn_ui_language"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="@string/settings_ui_language_button"
                    android:background="@drawable/bg_secondary_button"
                    android:textColor="@color/nr_primary"
                    android:fontFamily="@font/inter" android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_cyber_green" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_buddy_language"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="12dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_buddy_language_desc"
                    android:fontFamily="@font/inter" android:textSize="11sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/tv_buddy_language_current"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/lang_ja"
                    android:fontFamily="@font/inter" android:textSize="13sp"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="12dp" />

                <Button android:id="@+id/btn_buddy_language"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="@string/settings_buddy_language_button"
                    android:background="@drawable/bg_secondary_button"
                    android:textColor="@color/nr_primary"
                    android:fontFamily="@font/inter" android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STEP COUNTER section -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_glass_card"
                android:padding="20dp" android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/nr_primary" android:layout_marginRight="8dp"
                        android:minHeight="20dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/settings_step_counter"
                        android:fontFamily="@font/inter" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.08"
                        android:textColor="@color/nr_on_surface_variant" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/nr_outline_variant" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_measurement_mode"
                    android:fontFamily="@font/inter" android:textSize="10sp"
                    android:textStyle="bold" android:letterSpacing="0.08"
                    android:textColor="@color/nr_on_surface_variant"
                    android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_input"
                    android:layout_marginBottom="0dp">
                    <Button android:id="@+id/btn_step_mode_buddy"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/settings_step_buddy_only"
                        android:background="@drawable/bg_dark_segment_selected"
                        android:textColor="@color/nr_primary"
                        android:fontFamily="@font/inter" android:textSize="11sp"
                        android:textStyle="bold" android:letterSpacing="0.04" />
                    <Button android:id="@+id/btn_step_mode_always"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/settings_step_always_on"
                        android:background="@drawable/bg_dark_segment_unselected"
                        android:textColor="@color/nr_on_surface_variant"
                        android:fontFamily="@font/inter" android:textSize="11sp"
                        android:textStyle="bold" android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- TERMINATE SESSION -->
            <Button android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/settings_terminate"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/nr_primary"
                android:fontFamily="@font/inter" android:textSize="12sp"
                android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- WIPE MEMORY CORE -->
            <Button android:id="@+id/btn_purge_data"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/settings_wipe"
                android:background="@drawable/bg_danger_button"
                android:textColor="@color/nr_red"
                android:fontFamily="@font/inter" android:textSize="12sp"
                android:textStyle="bold" android:letterSpacing="0.08" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <include layout="@layout/include_bottom_nav" />
    </FrameLayout>
</LinearLayout>
